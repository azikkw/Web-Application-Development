{
  "info": {
    "name": "SpaceBounty Hunters",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "hunt_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Wanted Criminals",
      "item": [
        {
          "name": "List criminals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter: min_reward + armed + sort -reward",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: max_reward + has_crew + sort reward",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?max_reward=10000&has_crew=true&sort=reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "max_reward",
                  "value": "10000"
                },
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: escape_master",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?escape_master=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Criminal details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/2/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "2",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Hunt Logs",
      "item": [
        {
          "name": "List hunt logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            }
          }
        },
        {
          "name": "List hunt logs by criminal_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/?criminal_id=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('hunt_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get hunt log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Update hunt log",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Captured on the second attempt.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete hunt log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Invalid Requests",
      "item": [
        {
          "name": "Criminal not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/999/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "999",
                ""
              ]
            }
          }
        },
        {
          "name": "Invalid criminal id (422)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/abc/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "abc",
                ""
              ]
            }
          }
        },
        {
          "name": "Invalid sort value (422)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?sort=name",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "name"
                }
              ]
            }
          }
        },
        {
          "name": "Hunt log not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/999/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "999",
                ""
              ]
            }
          }
        },
        {
          "name": "Create hunt for non-existing criminal (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 999,\n  \"success\": false,\n  \"notes\": \"No such target.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create hunt with invalid body (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 1,\n  \"success\": \"maybe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}